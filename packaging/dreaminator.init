#!/bin/sh
### BEGIN INIT INFO
# Provides:          dreaminator
# Required-Start:    $network
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Dreaminator — IPTV playlists for Enigma2
### END INIT INFO

PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
export PATH

DAEMON=/usr/bin/dreaminator
PIDFILE=/var/run/dreaminator.pid
LOG=/tmp/dreaminator.log
ARGS="-listen :8088 -data /etc/dreaminator -log $LOG"

case "$1" in
  start)
    echo "Starting dreaminator"
    # Background work (EPG filtering, artwork, portal pages) must not take
    # the single CPU from the Enigma2 interface or the stream player.
    start-stop-daemon -S -b -m -N 10 -p "$PIDFILE" -x "$DAEMON" -- $ARGS
    ;;
  stop)
    echo "Stopping dreaminator"
    start-stop-daemon -K -p "$PIDFILE" -x "$DAEMON" 2>/dev/null
    rm -f "$PIDFILE"
    ;;
  restart|force-reload)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
